{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "haze",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-11",
  "build": {
    "command": "node build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEADERBOARD",
        "class_name": "Leaderboard"
      }
    ]
  },
  "exports": {
    "Leaderboard": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
